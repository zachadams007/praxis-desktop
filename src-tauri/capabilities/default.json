{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for all Praxis windows (brain, Flight Deck, Command Center, Memory Galaxy).",
  "windows": ["main", "flightdeck", "command", "knowledge", "voicepill"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "notification:default"
  ]
}
